{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/copybook-rs/schemas/resolved-manifest.json",
  "title": "ResolvedManifest",
  "description": "Resolved-schema manifest snapshot (#1117), document version 2. Stability class: beta (evolving; see the copybook_codec::resolved_manifest evolution rules). Reference for the copybook_codec::resolved_manifest::ResolvedManifest contract; the Rust type is authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stability_class",
    "fingerprint_algo",
    "inputs",
    "schema_fingerprint",
    "fields",
    "record_len",
    "record_len_min",
    "lrecl",
    "source_spans",
    "numeric_details",
    "odo_details",
    "condition_usages",
    "renames",
    "redefines_groups",
    "support",
    "manifest_fingerprint"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2,
      "description": "Manifest document schema version."
    },
    "stability_class": {
      "type": "string",
      "const": "beta",
      "description": "Stability class of the v2 manifest contract (beta while the bound profile contract settles)."
    },
    "fingerprint_algo": {
      "type": "string",
      "const": "sha256-v1",
      "description": "Fingerprint algorithm binding the manifest body."
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle",
        "profile",
        "tool",
        "encoding",
        "dialect",
        "framing",
        "record_bound"
      ],
      "properties": {
        "bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "fingerprint", "root_unit"],
          "properties": {
            "schema_version": {
              "type": "integer",
              "description": "Source-bundle contract version."
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "Source-bundle fingerprint the schema was resolved from."
            },
            "root_unit": {
              "type": "string",
              "description": "Logical id of the bundle's root unit."
            }
          }
        },
        "profile": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema_version", "fingerprint"],
              "properties": {
                "schema_version": {
                  "type": "integer",
                  "description": "Interpretation-profile contract version."
                },
                "fingerprint": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "Profile fingerprint over its canonical rendering."
                }
              }
            },
            {"type": "null"}
          ],
          "description": "Reviewed-profile identity; null for profile-less direct runs."
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string",
              "description": "Tool name that generated the manifest."
            },
            "version": {
              "type": "string",
              "description": "Tool package version that generated the manifest."
            }
          }
        },
        "encoding": {
          "$ref": "#/$defs/resolved_string",
          "description": "Effective encoding plus its resolution layer."
        },
        "dialect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "source", "provenance"],
          "properties": {
            "value": {
              "type": "string",
              "description": "Effective dialect in profile spelling."
            },
            "source": {
              "type": "string",
              "description": "Resolution layer in OptionSource display spelling."
            },
            "provenance": {
              "type": "string",
              "description": "Dialect selection provenance in canonical kebab-case."
            }
          }
        },
        "framing": {
          "$ref": "#/$defs/resolved_string",
          "description": "Effective framing plus its resolution layer."
        },
        "record_bound": {
          "anyOf": [
            {"$ref": "#/$defs/resolved_u64"},
            {"type": "null"}
          ],
          "description": "Effective record bound plus its resolution layer; null when the run is uncapped."
        }
      }
    },
    "schema_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Canonical schema fingerprint (SHA-256 over the schema's canonical JSON, recomputed at generation)."
    },
    "fields": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "level",
          "offset",
          "len",
          "end",
          "kind",
          "redefines",
          "synchronized",
          "blank_when_zero"
        ],
        "properties": {
          "path": {"type": "string"},
          "level": {"type": "integer", "minimum": 0, "maximum": 255},
          "offset": {"type": "integer", "minimum": 0},
          "len": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 0},
          "kind": {"type": "string"},
          "redefines": {"type": ["string", "null"]},
          "synchronized": {"type": "boolean"},
          "blank_when_zero": {"type": "boolean"},
          "occurs": {
            "type": "object",
            "description": "OCCURS repetition bound; omit for scalar fields (explicit null does not round-trip).",
            "additionalProperties": false,
            "required": ["kind", "count", "min_count"],
            "properties": {
              "kind": {"type": "string", "enum": ["fixed", "odo"]},
              "count": {"type": "integer", "minimum": 1, "description": "Fixed repetition count, or the ODO maximum."},
              "min_count": {"type": "integer", "minimum": 0, "description": "Minimum repetitions; equals count for fixed tables."},
              "counter_path": {"type": "string", "description": "ODO counter field path; absent for fixed tables."}
            }
          }
        }
      }
    },
    "record_len": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum field end offset across the flattened layout, in bytes."
    },
    "record_len_min": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Static minimum record extent in bytes; null for variable (ODO) layouts. Fixed layouts report the maximum."
    },
    "lrecl": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Declared fixed record length, when the schema states one."
    },
    "source_spans": {
      "type": "string",
      "const": "unavailable",
      "description": "Per-field source-span availability; the schema carries no spans yet."
    },
    "numeric_details": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digits", "scale", "signed", "encoding"],
        "properties": {
          "path": {"type": "string"},
          "digits": {"type": "integer", "minimum": 0},
          "scale": {"type": "integer"},
          "signed": {"type": "boolean"},
          "encoding": {"type": "string"}
        }
      }
    },
    "odo_details": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "counter_path", "min_count", "max_count", "is_tail"],
        "properties": {
          "path": {"type": "string"},
          "counter_path": {"type": "string"},
          "min_count": {"type": "integer", "minimum": 0},
          "max_count": {"type": "integer", "minimum": 0},
          "is_tail": {"type": "boolean"}
        }
      }
    },
    "condition_usages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {"type": "string"}
        }
      }
    },
    "renames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "offset", "length", "members"],
        "properties": {
          "path": {"type": "string"},
          "offset": {"type": "integer", "minimum": 0},
          "length": {"type": "integer", "minimum": 0},
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        }
      }
    },
    "redefines_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["storage", "views"],
        "properties": {
          "storage": {"type": "string"},
          "views": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string"}
          }
        }
      }
    },
    "support": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature", "status"],
        "properties": {
          "feature": {
            "type": "string",
            "description": "Feature identifier in kebab-case."
          },
          "status": {
            "type": "string",
            "description": "Support status in kebab-case."
          }
        }
      }
    },
    "manifest_fingerprint": {
      "type": "string",
      "pattern": "^sha256-v1:[a-f0-9]{64}$",
      "description": "Self-fingerprint binding every field above."
    }
  },
  "$defs": {
    "resolved_string": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": {"type": "string"},
        "source": {"type": "string"}
      }
    },
    "resolved_u64": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": {"type": "integer", "minimum": 0},
        "source": {"type": "string"}
      }
    }
  }
}
